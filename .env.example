#!/usr/bin/env dotenv
# @file .env.example
# @brief Шаблон глобальных переменных окружения для контейнеризированной фабрики.
# @author Мизиев Рашид Саит-Алиевич (rasidmiziev279@gmail.com)
# @date 2026-05-28
# @version 1.0.0
# @license GNU GPLv3
# @details
#   Файл содержит прототипы конфигураций для:
#   1. Сервисов баз данных (MongoDB/PostgreSQL)
#   2. Систем логирования и мониторинга
#   3. Секретов приложения

# ==============================================================================
# НАСТРОЙКИ СУБД (MONGODB / POSTGRESQL)
# ==============================================================================
# Хост и порт для подключения к базе данных
DB_HOST=db_service
DB_PORT=27017
DB_NAME=production_db

# ВНИМАНИЕ: Чувствительные данные! 
# Категорически запрещено раскомментировать и заполнять реальными паролями 
# в файле, отправляемом в Git-репозиторий.
# Данные значения заполняются локально администратором только в файле .env.
# DB_USER=database_admin_user
# DB_PASSWORD=generate_secure_password_here

# ==============================================================================
# НАСТРОЙКИ ВНЕШНИХ ИНТЕГРАЦИЙ И API-КЛЮЧЕЙ
# ==============================================================================
# URL сервисов для интеграции
API_URL=https://service.internal
# API_KEY=example_api_key_string_abcdef123456
# API_SECRET=example_high_entropy_secret_token_xyz789

# ==============================================================================
# КОНФИГУРАЦИЯ СРЕДЫ ВЫПОЛНЕНИЯ (RUNTIME ENVIRONMENT)
# ==============================================================================
# Допустимые режимы: development (отладка), staging (тестирование), production (пром)
APP_ENV=development
APP_DEBUG=true

# ==============================================================================
# КОНФИГУРАЦИЯ МОНИТОРИНГА (OPEN TELEMETRY)
# ==============================================================================
# Адрес коллектора метрик
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
