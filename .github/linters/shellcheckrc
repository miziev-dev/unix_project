# Использовать синтаксис расширенного Bash (или sh, если пишется POSIX скрипт)
shell=bash

# Включить дополнительные проверки безопасности
enable=all

# Исключения из правил (опционально):
# SC1090 — разрешить динамический source (подключение внешних библиотек через .env)
# SC2155 — разрешить одновременное объявление и присваивание local (local var=$(cmd))
disable=SC1090,SC2155
