[flake8]
# Ограничение длины строки согласно PEP 8
max-line-length = 120

# Исключить служебные каталоги и виртуальные окружения из сканирования
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    thesis/

# Стандартные коды ошибок для игнорирования (при необходимости):
# E203 — пробел перед двоеточием (конфликтует с автоформатером Black)
# W503 — перенос строки перед бинарным оператором
ignore = E203, W503

# Контроль сложности кода (цикломатическая сложность функций)
max-complexity = 10
