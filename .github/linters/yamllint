---
extends: default

rules:
  # Требовать отступы строго в 2 пробела
  indentation:
    spaces: 2
    indent-sequences: true

  # Ограничение длины строки (80-120 символов — стандарт читаемости)
  line-length:
    max: 120
    allow-non-breakable-words: true

  # Запретить использование символов табуляции (\t)
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no']

  # Контроль пустых строк
  empty-lines:
    max: 2

  # Требовать пустую строку в конце файла (POSIX стандарт)
  new-line-at-end-of-file: enable

  # Контроль пробелов возле двоеточий и внутри фигурных скобок
  colons:
    max-spaces-before: 0
    max-spaces-after: 1
